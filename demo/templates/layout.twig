<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Framework312{% endblock %}</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f4f6fa;color:#17243b;font:16px/1.6 system-ui,sans-serif}header{background:#17243b;color:white;padding:18px 24px}nav{max-width:960px;margin:auto;display:flex;gap:22px;align-items:center;flex-wrap:wrap}nav a{color:#dce8ff;text-decoration:none}nav strong{margin-right:auto}main{max-width:960px;margin:48px auto;padding:0 24px}h1{font-size:clamp(28px,5vw,44px);line-height:1.15;margin:12px 0}h2{font-size:20px}p{color:#526078}.eyebrow{font-size:13px;letter-spacing:2px;color:#315ca8;font-weight:700}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px;margin:32px 0}.panel{background:white;border:1px solid #dce3ef;border-radius:12px;padding:24px}a.action,button{display:inline-block;background:#315ca8;color:white;border:0;border-radius:6px;padding:10px 16px;text-decoration:none;font:inherit;cursor:pointer}code{background:#eaf0fa;padding:3px 6px;border-radius:4px;overflow-wrap:anywhere}footer{max-width:960px;margin:40px auto;padding:24px;color:#526078;border-top:1px solid #dce3ef}a:focus-visible,button:focus-visible{outline:3px solid #e6a23c;outline-offset:3px}
</style></head><body>
<header><nav aria-label="Navigation principale"><strong>Framework312</strong><a href="/">Accueil</a><a href="/book/42">Twig</a><a href="/hello">HTML</a><a href="/api/books/42">JSON</a></nav></header>
<main>{% block body %}{% endblock %}</main><footer>UE L312 · Démonstration du micro-framework PHP</footer></body></html>
